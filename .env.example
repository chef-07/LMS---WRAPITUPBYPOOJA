# Supabase (Project settings → API). Leave empty to run in demo mode with sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site address, used for magic-link redirects and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Reminder emails (optional). Without RESEND_API_KEY nothing is sent.
# See README → "Turn on reminder emails".
RESEND_API_KEY=
EMAIL_FROM="Wrap It Up University <university@wrapitupbypooja.com>"
# A long random string. Its SHA-256 goes in private.cron_keys; Vercel Cron sends it to /api/cron/*.
CRON_SECRET=
